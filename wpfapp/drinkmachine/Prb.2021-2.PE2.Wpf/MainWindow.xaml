<Window x:Class="Prb._2021_2.PE2.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prb._2021_2.PE2.Wpf"
        mc:Ignorable="d"
        Title="Drankautomaat" Height="493" Width="1170" WindowStartupLocation="CenterScreen" Loaded="Window_Loaded"
        >
    <Grid>
        <GroupBox x:Name="grpStep1" Header="Stap 1 : kies je drankje" HorizontalAlignment="Left" Height="436" Margin="10,10,0,0" VerticalAlignment="Top" Width="265">
            <Grid>
                <Button x:Name="btnConfirmBeverage" Background="Gold" Foreground="SteelBlue" FontSize="16" FontWeight="Bold" Content="Bevestig keuze" HorizontalAlignment="Left" Height="47" Margin="10,356,0,0" VerticalAlignment="Top" Width="233" Click="btnConfirmBeverage_Click" />
                <ListBox x:Name="lstBeverage" HorizontalAlignment="Left" Height="328" Margin="10,10,0,0" VerticalAlignment="Top" Width="233" Grid.ColumnSpan="2"/>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="grpStep2" Header="Stap 2 : betalen"   HorizontalAlignment="Left" Height="436" Margin="292,10,0,0" VerticalAlignment="Top" Width="265">
            <Grid>
                <Label Content="Gekozen drank : " HorizontalAlignment="Center" Height="29" VerticalAlignment="Top" Width="227"/>
                <Label x:Name="lblChosenBeverage" Background="SteelBlue" Foreground="White" FontSize="14" 
                       FontWeight="Bold" HorizontalAlignment="Center" Height="29" Margin="0,33,0,0" VerticalAlignment="Top" Width="233"/>
                <Label Content="Nog te betalen : " HorizontalAlignment="Left" Height="29" Margin="10,80,0,0" VerticalAlignment="Top" Width="227"/>
                <Label x:Name="lblToPay" Background="SteelBlue" Foreground="White" FontSize="16"  HorizontalContentAlignment="Right"
                       FontWeight="Bold" HorizontalAlignment="Center" Height="29" Margin="0,114,0,0" VerticalAlignment="Top" Width="233"/>
                <Button x:Name="btnCancel" Background="Tomato" Foreground="White" FontSize="16" FontWeight="Bold" Content="Annuleren" HorizontalAlignment="Center" Height="47" Margin="0,356,0,0" VerticalAlignment="Top" Width="243" Click="btnCancel_Click" />
                <Button x:Name="btn2Euro" Content="2€" FontSize="20" Background="LightGray" Foreground="DarkGoldenrod" HorizontalAlignment="Left" Height="66" Margin="16,160,0,0" VerticalAlignment="Top" Width="72" Click="btn2Euro_Click"  >
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="35"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="btn1Euro" Content="1€" FontSize="20" Background="LightGray" Foreground="DarkGoldenrod" HorizontalAlignment="Center" Height="56" Margin="0,165,0,0" VerticalAlignment="Top" Width="58" RenderTransformOrigin="-0.015,0.333" Click="btn1Euro_Click"  >
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="35"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="btn50C" Content="50C" FontSize="20" Background="Peru" Foreground="gold" HorizontalAlignment="Left" Height="62" Margin="22,231,0,0" VerticalAlignment="Top" Width="66" Click="btn50C_Click"  >
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="35"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="btn20C" Content="20C" FontSize="20" Background="Peru" Foreground="gold" HorizontalAlignment="Center" Height="60" Margin="0,231,0,0" VerticalAlignment="Top" Width="60" Click="btn20C_Click"  >
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="35"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Button x:Name="btn10C" Content="10C" FontSize="20" Background="Peru" Foreground="gold" HorizontalAlignment="Left" Height="50" Margin="162,237,0,0" VerticalAlignment="Top" Width="48" Click="btn10C_Click"  >
                    <Button.Resources>
                        <Style TargetType="{x:Type Border}">
                            <Setter Property="CornerRadius" Value="35"/>
                        </Style>
                    </Button.Resources>
                </Button>
                <Label x:Name="lblChosenBeverage_Copy1" Background="OliveDrab" Foreground="White" FontSize="14" 
                    FontWeight="Bold" HorizontalAlignment="Left" Height="28" Margin="303,48,0,0" VerticalAlignment="Top" Width="233"/>
            </Grid>
        </GroupBox>
        <GroupBox x:Name="grpStep3A" Header="Stap 3A : aflevering" HorizontalAlignment="Left" Height="159" Margin="575,10,0,0" VerticalAlignment="Top" Width="265">
            <Grid>
                <Label Content="Neem je drankje" HorizontalAlignment="Center" Height="24" VerticalAlignment="Top" Width="233"/>
                <Label x:Name="lblBeverageDelivered" Background="OliveDrab" Foreground="White" FontSize="14" 
                    FontWeight="Bold" HorizontalAlignment="Center" Height="29" Margin="0,33,0,0" VerticalAlignment="Top" Width="233"/>

                <Button x:Name="btnBeverageAccepted" Background="Gold" Foreground="SteelBlue" FontSize="16" FontWeight="Bold"  Content="Drankje aannemen" HorizontalAlignment="Center" Height="46" Margin="0,84,0,0" VerticalAlignment="Top" Width="233" Click="btnBeverageAccepted_Click" />

            </Grid>
        </GroupBox>
        <GroupBox x:Name="grpStep3B" Header="Stap 3B : teruggave" HorizontalAlignment="Left" Height="259" Margin="575,187,0,0" VerticalAlignment="Top" Width="265">
            <Grid>
                <Label Content="Teruggave : " HorizontalAlignment="Left" Height="25" Margin="10,10,0,0" VerticalAlignment="Top" Width="233" Grid.ColumnSpan="2"/>
                <Label x:Name="lblReturnChange" Background="OliveDrab" Foreground="White" FontSize="14" 
                    FontWeight="Bold" HorizontalAlignment="Center" Height="136" HorizontalContentAlignment="right" Margin="0,40,0,0" VerticalAlignment="Top" Width="233"/>
                <Button x:Name="btnChangeAccepted" Background="Gold" Foreground="SteelBlue" FontSize="16" FontWeight="Bold"  Content="Teruggave aannemen" HorizontalAlignment="Center" Height="45" Margin="0,181,0,0" VerticalAlignment="Top" Width="233" Click="btnChangeAccepted_Click" />
            </Grid>
        </GroupBox>
        <GroupBox x:Name="grpStats" Header="Statistiek" HorizontalAlignment="Left" Height="436" Margin="862,10,0,0" VerticalAlignment="Top" Width="265">
            <Grid>

                <Label Content="Verkopen : " HorizontalAlignment="Left" Height="24" VerticalAlignment="Top" Width="233" Grid.ColumnSpan="2" Margin="10,0,0,0"/>
                <ListBox x:Name="lstSales" HorizontalAlignment="Center" Height="332" Margin="0,29,0,0" VerticalAlignment="Top" Width="233"/>
                <Label  Content="Totaal : " HorizontalAlignment="Left" Height="24" VerticalAlignment="Top" Width="54" Margin="10,379,0,0"/>
                <Label x:Name="lblTotal" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Right" Content="" HorizontalAlignment="Left" Height="37" Margin="82,366,0,0" VerticalAlignment="Top" Width="161"/>

            </Grid>
        </GroupBox>
    </Grid>



</Window>
    
    
