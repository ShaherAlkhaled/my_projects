<Window x:Class="Prb.Pe1.Facturatie.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Prb.Pe1.Facturatie.Wpf"
        mc:Ignorable="d"
        Title="Facturatie" Height="400" Width="800" Loaded="Window_Loaded">
    <Grid Background="Aquamarine">
        <DatePicker x:Name="dtpDate"  HorizontalAlignment="Left" Margin="20,40,0,0" VerticalAlignment="Top" Height="22" Width="125"/>
        <ComboBox x:Name="cmbStartHour"  HorizontalAlignment="Left" Margin="176,40,0,0" VerticalAlignment="Top" Height="22"  Width="80"/>
        <ComboBox x:Name="cmbEndHour" HorizontalAlignment="Left" Margin="274,40,0,0" VerticalAlignment="Top" Height="22" Width="80"/>
        <TextBox x:Name="txtHourRate" HorizontalContentAlignment="Right"  HorizontalAlignment="Left" Margin="376,40,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="67" Height="22"/>
        <ComboBox x:Name="cmbVAT" HorizontalAlignment="Left" Margin="479,40,0,0" VerticalAlignment="Top" Height="22" Width="60"/>
        <Button x:Name="btnAdd" Content="Voeg toe" HorizontalAlignment="Left" Margin="590,40,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.512,0.226" Height="22" Width="82" Click="BtnAdd_Click"/>
        <Button x:Name="btnRemove" Content="Verwijder" HorizontalAlignment="Left" Margin="690,40,0,0" VerticalAlignment="Top" Height="22" Width="66" Click="BtnRemove_Click"/>
        <Label Content="Datum" HorizontalAlignment="Left" Margin="40,10,0,0" VerticalAlignment="Top" Height="25" Width="50"/>
        <Label Content="Startuur" HorizontalAlignment="Left" Margin="180,10,0,0" VerticalAlignment="Top" Width="60" Height="25"/>
        <Label Content="Einduur" HorizontalAlignment="Left" Margin="280,10,0,0" VerticalAlignment="Top" Height="25" Width="60"/>
        <Label Content="Uurtarief" HorizontalAlignment="Left" Margin="377,10,0,0" VerticalAlignment="Top" Height="25"  Width="60"/>
        <Label Content="BTW (%)" HorizontalAlignment="Left" Margin="480,10,0,0" VerticalAlignment="Top"  Height="25" Width="60"/>
        <ListBox x:Name="lstReuslt" Background="OldLace" Margin="20,84,20,70" SelectionChanged="LstReuslt_SelectionChanged"/>
        <Label Content="Totaalprijs (excl BTW)" HorizontalAlignment="Left" Margin="180,310,0,0" VerticalAlignment="Top" Height="25" Width="130"/>
        <Label x:Name="lblTotalNet" Content="€ 0.00" Background="OldLace" HorizontalAlignment="Left" Margin="330,310,0,0" VerticalAlignment="Top" Height="25" Width="100"/>
        <Label   Content="Totaalprijs (incl BTW)" FontFamily="Times New Roman Bold" HorizontalAlignment="Left" Margin="450,310,0,0" VerticalAlignment="Top" Height="25" Width="130"/>
        <Label x:Name="lblTatolGross" Content="€ 0.00" Background="OldLace" FontFamily="Times New Roman Bold" HorizontalAlignment="Left" Margin="669,310,0,0" VerticalAlignment="Top" Height="25  " Width="100"/>

    </Grid>
</Window>
